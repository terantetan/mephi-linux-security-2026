   30  sudo -l -U user1
   31  echo ;
   32  echo 'user1 All=(root) /usr/bin/date' >> /etc/sudoers
   33  sudo -l -U user1
   34  echo 'user1 ALL=(root) /usr/bin/date' >> /etc/sudoers
   35  sudo -l -U user1
