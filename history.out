   12  ps -eo ruid,euid,pid,args | awk '$2==0 && $1>=1000' > root/ps_suid.out
   13  ps -eo ruid,euid,pid,args | awk '$2==0 && $1>=1000' > /root/ps_suid.out
   14  cat /root/ps_suid.out
   15  history -n
   16  cp /usr/bin/cat /home/user1/mycat
   17  su - user1 -c '/home/user1/mycat /etc/shadow'
